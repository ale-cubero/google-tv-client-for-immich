<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView backed by a TextureView (not the default SurfaceView) so it correctly applies the
  display-rotation matrix that Samsung/Apple motion-photo clips carry (landscape-coded video with
  a 90/270° rotation flag). SurfaceView ignores that rotation and renders the frame stretched.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:show_buffering="never" />
