<?xml version="1.0" encoding="utf-8"?>
<!--
  PlayerView backed by a SurfaceView (the default). A SurfaceView hands frames straight to the
  display compositor, which is required for true HDR (HLG/PQ) passthrough — a TextureView composites
  through the GPU and always tone-maps HDR down to SDR. Used for ordinary videos; motion-photo clips
  use the TextureView variant (video_surface.xml) because they need the display-rotation matrix.
-->
<androidx.media3.ui.PlayerView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="surface_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:show_buffering="never" />
